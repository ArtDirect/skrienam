# Cloudflare Pages reads this file. GitHub Pages ignores it, so it is safe
# to keep in the repo while both are live.
#
# GitHub Pages forces Cache-Control: max-age=600 on HTML, which is why a
# change can take ten minutes to show on a phone. Here we can say otherwise:
# always revalidate the page and the config, cache the artwork.

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/config.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400
